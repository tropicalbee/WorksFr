#!/bin/sh

if ! docker info >/dev/null 2>&1; then
    printf '%s\n' 'Warning: Docker is unavailable. Skipping the staged gitleaks scan.' >&2
    exit 0
fi

exec docker run --rm -v "$(pwd):/repo:ro" 'zricethezav/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f' protect --staged --source /repo --no-banner --redact
