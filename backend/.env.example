# Copy this file to backend/.env and fill in your own values.
# Leave a value empty to use the default named in its comment.

# =============================================================
# LLM providers (any OpenAI-compatible endpoint, see ADR-009)
# =============================================================
# Providers are tried in this order. To add one, put its name here
# and add a LLM_<NAME>_BASE_URL / _API_KEY / _MODEL block below.
# Hyphens in a name become underscores (my-host -> LLM_MY_HOST_*).
LLM_PROVIDERS=nvidia,groq,gemini
# Maximum accepted Retry-After wait in seconds. Default: 20
LLM_MAX_WAIT_SECONDS=

# NVIDIA (build.nvidia.com)
LLM_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_NVIDIA_API_KEY=
LLM_NVIDIA_MODEL=
# Minimum gap between requests in seconds. Default: 0
LLM_NVIDIA_MIN_INTERVAL_SECONDS=

# Groq (console.groq.com)
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=
# Minimum gap between requests in seconds. Default: 0
LLM_GROQ_MIN_INTERVAL_SECONDS=

# Google Gemini (aistudio.google.com)
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=
# Minimum gap between requests in seconds. Default: 0
LLM_GEMINI_MIN_INTERVAL_SECONDS=

# =============================================================
# Web search (optional; without it, repairs use PyPI and GitHub only)
# =============================================================
TAVILY_API_KEY=

# =============================================================
# Page reader (only for pages whose code is loaded by JavaScript; optional)
# =============================================================
# Tried in this order. Never used for pages that refuse us or ask for a login.
READER_PROVIDERS=firecrawl,jina
# Firecrawl (firecrawl.dev). Skipped without a key.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Jina Reader (jina.ai/reader). The key is optional.
JINA_API_KEY=
JINA_READER_BASE_URL=https://r.jina.ai/

# =============================================================
# Video reader (native Interactions API; optional)
# =============================================================
# YouTube Data API v3 key for description and author-comment links (optional)
YOUTUBE_API_KEY=
VIDEO_READER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VIDEO_READER_API_KEY=
# One model or a comma-separated list in fallback order, e.g. primary-model,fallback-model
VIDEO_READER_MODEL=
# Seconds per video chunk. Default: 300
VIDEO_CHUNK_SECONDS=300
# Maximum video length in minutes. Default: 60
VIDEO_MAX_MINUTES=60
# Independent reads per video clip, 1 to 3. Code seen in 2 or more reads is confirmed. Default: 2
VIDEO_READS=2
# Optional folder for redacted raw video replies, for example ../.scratch/video-replies.
VIDEO_DEBUG_DIR=
# By enabling VIDEO_DOWNLOAD, you are responsible for following YouTube's terms.
VIDEO_DOWNLOAD=false
VIDEO_DOWNLOAD_MAX_MB=1024
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=600
VIDEO_TOOLS_IMAGE=worksfr-video-tools
# Download container memory. Default: 512m
VIDEO_TOOLS_MEMORY=
# Download container CPUs. Default: 1
VIDEO_TOOLS_CPUS=
# Download container process limit. Default: 128
VIDEO_TOOLS_PIDS_LIMIT=
# Download container /tmp size in MiB. Default: 64
VIDEO_TOOLS_TMPFS_MB=
# Minimum gap between video reader requests in seconds. Default: 0
VIDEO_READER_MIN_INTERVAL_SECONDS=0

# =============================================================
# Storage
# =============================================================
# Default: worksfr.db
DATABASE_PATH=

# =============================================================
# Sandbox
# =============================================================
# Default: worksfr-sandbox
SANDBOX_IMAGE=
# GPU access. Use all, a positive count, or device=0,2. Default: disabled
SANDBOX_GPUS=
# Image used when GPU access is enabled. Default: same as SANDBOX_IMAGE
SANDBOX_GPU_IMAGE=
# Seconds per step. Default: 60
STEP_TIMEOUT_SECONDS=
# Seconds per whole check. Default: 900
CHECK_TIMEOUT_SECONDS=
# Default: 2g
SANDBOX_MEMORY=
# MiB available on /tmp. Default: 512
SANDBOX_TMPFS_MB=
# Maximum size in MiB of an individual file written by a sandbox process. Default: 256
SANDBOX_FILE_SIZE_MB=
# Largest file in MiB a package install may write (the runner lowers it to the limit above). Default: 1024
SANDBOX_INSTALL_FILE_SIZE_MB=
# Default: 2.0
SANDBOX_CPUS=
# Default: 256
SANDBOX_PIDS_LIMIT=
# Skip Python wheels above this size in MB, when the size is known.
SANDBOX_MAX_PACKAGE_MB=400
# Optional Python index overrides.
# Example: torch=https://download.pytorch.org/whl/cpu,torchvision=https://download.pytorch.org/whl/cpu
SANDBOX_PACKAGE_INDEXES=

# Required only for API requests from other machines.
API_TOKEN=

# =============================================================
# API
# =============================================================
# Comma-separated. Requests from any other browser origin get 403.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=
# Default: 1 concurrent check
MAX_CONCURRENT_CHECKS=
# Default: 10 MB per notebook
MAX_UPLOAD_MB=
# Default: 150 runnable cells per notebook
MAX_STEPS=

# =============================================================
# MCP server
# =============================================================
# Where the MCP server finds the backend. Default: http://127.0.0.1:8000
WORKSFR_API_URL=
