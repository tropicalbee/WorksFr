# LLM providers
# Add a name to LLM_PROVIDERS in fallback order.
# Set its LLM_<NAME>_BASE_URL, _API_KEY and _MODEL (hyphens become underscores).
LLM_PROVIDERS=nvidia,groq,gemini
LLM_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_NVIDIA_API_KEY=
LLM_NVIDIA_MODEL=
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=

# Web search (Tavily; default: empty)
TAVILY_API_KEY=
# Storage (default: worksfr.db)
DATABASE_PATH=
# Sandbox limits and timeouts
# Default: worksfr-sandbox
SANDBOX_IMAGE=
# Default: 60 seconds
STEP_TIMEOUT_SECONDS=
# Default: 900 seconds
CHECK_TIMEOUT_SECONDS=
# Default: 2g
SANDBOX_MEMORY=
# Default: 2.0
SANDBOX_CPUS=
# Default: 256
SANDBOX_PIDS_LIMIT=
# API (CORS; default: http://localhost:5173)
CORS_ORIGINS=
